{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cero",
  "version": "2.2.2",
  "identifier": "org.cero.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cero",
        "width": 1024,
        "height": 768,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-native terminal for macOS, Linux and Windows",
    "longDescription": "A desktop terminal that takes requests in plain language, runs .flow setup files on macOS, Windows and Linux, and can use a model that runs on your own computer.",
    "copyright": "2026 Cero Contributors",
    "resources": {
      "icons/flow/flow.ico": "flow.ico"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Resources/flow.icns": "icons/flow/flow.icns"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1 | libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/share/mime/packages/cero-terminal.xml": "../packaging/linux/cero-terminal-mime.xml",
          "/usr/share/icons/hicolor/16x16/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-16.png",
          "/usr/share/icons/hicolor/24x24/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-24.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-512.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-cero-workflow.svg": "../assets/brand/flow-icon.svg"
        },
        "desktopTemplate": "../packaging/linux/cero-terminal.desktop.hbs",
        "postInstallScript": "../packaging/linux/postinst.sh",
        "postRemoveScript": "../packaging/linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1"
        ],
        "files": {
          "/usr/share/mime/packages/cero-terminal.xml": "../packaging/linux/cero-terminal-mime.xml",
          "/usr/share/icons/hicolor/16x16/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-16.png",
          "/usr/share/icons/hicolor/24x24/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-24.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-cero-workflow.png": "icons/flow/flow-512.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-cero-workflow.svg": "../assets/brand/flow-icon.svg"
        },
        "desktopTemplate": "../packaging/linux/cero-terminal.desktop.hbs",
        "postInstallScript": "../packaging/linux/postinst.sh",
        "postRemoveScript": "../packaging/linux/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "flow"
        ],
        "name": "Cero Flow",
        "description": "Cero workflow",
        "role": "Editor",
        "mimeType": "application/x-cero-workflow"
      }
    ]
  }
}
