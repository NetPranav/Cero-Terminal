[Desktop Entry]
Name=Sentinel Terminal
Comment=Autonomous AI-Native Linux Terminal Copilot
GenericName=Terminal Emulator
Exec=sentinel-terminal %U
Icon=sentinel-terminal
Type=Application
Terminal=false
StartupNotify=true
StartupWMClass=sentinel-terminal
Categories=Development;System;TerminalEmulator;Utility;
Keywords=terminal;shell;copilot;prompt;pty;ai;
MimeType=inode/directory;x-scheme-handler/sentinel;application/x-sentinel-workflow;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=Open New Window
Exec=sentinel-terminal
