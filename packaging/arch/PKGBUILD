# Maintainer: Cero Contributors
pkgname=cero-terminal-bin
pkgver=2.2.0
pkgrel=1
pkgdesc="A terminal that takes requests in plain language and runs .flow setup files"
arch=('x86_64')
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'openssl'
    'glib2'
    'cairo'
    'pango'
    'shared-mime-info'
    'desktop-file-utils'
)
optdepends=(
    'vte3: Enhanced terminal capability support'
    'curl: Network diagnostic features'
    'xdg-utils: Desktop URL scheme and directory handling'
)
provides=('cero-terminal' 'cero')
conflicts=('cero-terminal' 'sentinel-terminal-bin')
replaces=('sentinel-terminal-bin')
options=('!debug')
source=(
    "cero-terminal"
    "cero"
    "cero-shell"
    "cero-terminal.desktop"
    "cero_open.desktop"
    "icon.png"
    "128x128.png"
    "32x32.png"
    "cero-terminal-mime.xml"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # Install main GUI binary and CLI launcher scripts
    install -Dm755 "${srcdir}/cero-terminal" "${pkgdir}/usr/bin/cero-terminal"
    install -Dm755 "${srcdir}/cero" "${pkgdir}/usr/bin/cero"
    install -Dm755 "${srcdir}/cero-shell" "${pkgdir}/usr/bin/cero-shell"

    # Install FreeDesktop application entry
    install -Dm644 "${srcdir}/cero-terminal.desktop" "${pkgdir}/usr/share/applications/cero-terminal.desktop"

    # Install Dolphin KIO service menu
    install -Dm644 "${srcdir}/cero_open.desktop" "${pkgdir}/usr/share/kio/servicemenus/cero_open.desktop"

    # .flow files open with Cero (pacman's shared-mime-info hook updates the database)
    install -Dm644 "${srcdir}/cero-terminal-mime.xml" "${pkgdir}/usr/share/mime/packages/cero-terminal.xml"

    # Install app icons
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cero-terminal.png"
    install -Dm644 "${srcdir}/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/cero-terminal.png"
    install -Dm644 "${srcdir}/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/cero-terminal.png"

    # Install flow mimetype icons
    for size in 16 24 32 48 64 128 256 512; do
        if [ -f "${srcdir}/flow-${size}.png" ]; then
            install -Dm644 "${srcdir}/flow-${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/mimetypes/application-x-cero-workflow.png"
        fi
    done
    if [ -f "${srcdir}/application-x-cero-workflow.svg" ]; then
        install -Dm644 "${srcdir}/application-x-cero-workflow.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/mimetypes/application-x-cero-workflow.svg"
    fi
}
