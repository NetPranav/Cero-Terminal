{
  "id": "system.service",
  "version": "1.0.0",
  "displayName": "Manage System Service",
  "description": "Starts, stops, restarts, enables, disables, or inspects status of Windows services.",
  "domain": "system",
  "category": "System",
  "tags": [
    "system",
    "service",
    "daemon",
    "startup",
    "background",
    "windows-service"
  ],
  "aliases": [
    "start service",
    "stop service",
    "restart service",
    "enable service",
    "disable service",
    "service status",
    "check service",
    "Get-Service",
    "sc query"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "SystemServices"
  ],
  "securityRisk": "MEDIUM",
  "parameters": [
    {
      "name": "service",
      "type": "string",
      "description": "Name of the system service (e.g. docker, postgresql, bluetooth, nginx)",
      "required": true
    },
    {
      "name": "action",
      "type": "string",
      "description": "Action to perform: start, stop, restart, enable, disable, status",
      "required": true
    }
  ],
  "optionalParameters": [],
  "estimatedExecutionTime": "2s",
  "confirmationRequired": false,
  "undoable": true
}
