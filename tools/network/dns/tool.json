{
  "id": "network.dns",
  "version": "1.0.0",
  "displayName": "Query DNS Domain Records",
  "description": "Performs DNS resolution lookup for A, CNAME, MX, and TXT records (dig/nslookup).",
  "domain": "network",
  "category": "Networking",
  "tags": [
    "network",
    "dns",
    "network.dns",
    "query",
    "domain",
    "records",
    "lookup",
    "nslookup",
    "dig",
    "check"
  ],
  "aliases": [
    "lookup dns",
    "nslookup domain",
    "dig domain records",
    "check dns records",
    "dns lookup"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "SAFE",
  "parameters": [
    {
      "name": "domain",
      "type": "string",
      "description": "Target domain name to query",
      "required": true
    }
  ],
  "optionalParameters": [
    {
      "name": "recordType",
      "type": "string",
      "description": "Record type A, AAAA, MX, CNAME, TXT, or ALL",
      "required": false,
      "default": "ALL"
    }
  ],
  "estimatedExecutionTime": "1s",
  "confirmationRequired": false,
  "rollbackAvailable": false,
  "verificationSupported": true,
  "deprecationStatus": "stable"
}
