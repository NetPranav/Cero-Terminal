{
  "id": "shell.execute",
  "version": "1.0.0",
  "displayName": "Execute Terminal Shell Command",
  "description": "Executes a complete PowerShell command line, including installed CLI tools, pipes, redirects, and cmdlets.",
  "domain": "shell",
  "category": "Shell",
  "tags": [
    "shell",
    "execute",
    "shell.execute",
    "terminal",
    "command",
    "run",
    "powershell"
  ],
  "aliases": [
    "run command",
    "execute shell",
    "terminal exec",
    "powershell command"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "MEDIUM",
  "parameters": [
    {
      "name": "command",
      "type": "string",
      "description": "Complete PowerShell command line to run, for example: git status --short",
      "required": true
    }
  ],
  "optionalParameters": [
    {
      "name": "explanation",
      "type": "string",
      "description": "One-line plain English explanation of what the command does, without jargon",
      "required": false
    },
    {
      "name": "cwd",
      "type": "string",
      "description": "Working directory path",
      "required": false
    }
  ],
  "estimatedExecutionTime": "2s",
  "confirmationRequired": false,
  "rollbackAvailable": false,
  "verificationSupported": true,
  "deprecationStatus": "stable"
}
