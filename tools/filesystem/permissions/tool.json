    "change permissions",
    "chmod",
    "chown",
    "file permissions"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "WriteFiles"
  ],
  "securityRisk": "MEDIUM",
  "parameters": [
    {
      "name": "path",
