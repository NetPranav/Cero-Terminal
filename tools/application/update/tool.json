{
  "id": "application.update",
  "version": "1.0.0",
  "displayName": "Update Application",
  "description": "Checks for updates and upgrades an application with winget. Apps that ship with Windows (File Explorer, Settings) are updated through Windows Update.",
  "domain": "application",
  "category": "Application",
  "tags": [
    "application",
    "update",
    "upgrade",
    "winget"
  ],
  "aliases": [
    "update app",
    "upgrade app",
    "update application"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "MEDIUM",
  "parameters": [
    {
      "name": "app",
      "type": "string",
      "required": true,
      "description": "Name of the application to update."
    }
  ],
  "optionalParameters": [],
  "estimatedExecutionTime": "30s",
  "confirmationRequired": true,
  "rollbackAvailable": false,
  "verificationSupported": false,
  "deprecationStatus": "stable"
}
