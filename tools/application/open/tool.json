{
  "id": "application.open",
  "version": "1.0.0",
  "displayName": "Open Desktop Application",
  "description": "Opens a system desktop application with Start-Process with optional URL, file, or target arguments.",
  "domain": "application",
  "category": "Desktop",
  "tags": [
    "application",
    "open",
    "application.open",
    "desktop",
    "launch",
    "run",
    "start"
  ],
  "aliases": [
    "open app",
    "launch app",
    "run program",
    "start application",
    "open url in app",
    "open website in app"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "SAFE",
  "parameters": [
    {
      "name": "app",
      "type": "string",
      "description": "Application name or bundle path",
      "required": true
    }
  ],
  "optionalParameters": [
    {
      "name": "url",
      "type": "string",
      "description": "Optional web URL or domain to open in application",
      "required": false
    },
    {
      "name": "file",
      "type": "string",
      "description": "Optional file path to open in application",
      "required": false
    },
    {
      "name": "args",
      "type": "string",
      "description": "Optional command line target arguments",
      "required": false
    }
  ],
  "estimatedExecutionTime": "1s",
  "confirmationRequired": false,
  "rollbackAvailable": false,
  "verificationSupported": true,
  "deprecationStatus": "stable"
}
