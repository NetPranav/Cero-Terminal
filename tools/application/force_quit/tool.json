  "domain": "application",
  "category": "Desktop",
  "tags": [
    "application",
    "force_quit",
    "application.force",
    "quit",
    "force",
    "kill"
  ],
  "aliases": [
    "force quit app",
    "kill application",
    "kill process app",
    "force close"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ProcessManagement"
  ],
  "securityRisk": "HIGH",
  "parameters": [
