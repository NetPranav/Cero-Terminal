{
  "id": "browser.navigate",
  "version": "1.0.0",
  "displayName": "Navigate Browser to URL",
  "description": "Launches default system web browser and navigates directly to web URL.",
  "domain": "browser",
  "category": "Web",
  "tags": [
    "browser",
    "navigate",
    "browser.navigate",
    "to",
    "url",
    "go",
    "open",
    "visit"
  ],
  "aliases": [
    "go to website",
    "open url",
    "navigate to",
    "visit url"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "SAFE",
  "parameters": [
    {
      "name": "url",
      "type": "string",
      "description": "Web address to visit",
      "required": true
    }
  ],
  "optionalParameters": [
    {
      "name": "appName",
      "type": "string",
      "description": "Optional target web browser application (e.g., Edge, Chrome, Firefox, Brave)",
      "required": false
    },
    {
      "name": "browser",
      "type": "string",
      "description": "Alias for appName (e.g., Edge, Chrome, Firefox)",
      "required": false
    }
  ],
  "estimatedExecutionTime": "1s",
  "confirmationRequired": false,
  "rollbackAvailable": false,
  "verificationSupported": true,
  "deprecationStatus": "stable"
}
