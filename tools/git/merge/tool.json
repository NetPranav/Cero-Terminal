  "category": "Git",
  "tags": [
    "git",
    "merge",
    "git.merge",
    "branch"
  ],
  "aliases": [
    "git merge",
    "merge branch into current"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "MEDIUM",
  "parameters": [
    {
      "name": "branch",
      "type": "string",
      "description": "Source branch to merge into current branch",
      "required": true
    }
  ],
  "optionalParameters": [],
  "estimatedExecutionTime": "2s",
  "confirmationRequired": false,
  "rollbackAvailable": false,
  "verificationSupported": true,
  "deprecationStatus": "stable"
}
