  "domain": "git",
  "category": "Git",
  "tags": [
    "git",
    "stash",
    "git.stash",
    "workspace",
    "modifications",
    "pop"
  ],
  "aliases": [
    "git stash",
    "stash changes",
    "pop git stash"
  ],
  "supportedPlatforms": [
    "windows"
  ],
  "requiredPermissions": [
    "ShellExecution"
  ],
  "securityRisk": "LOW",
  "parameters": [],
  "optionalParameters": [
    {
      "name": "operation",
      "type": "string",
      "description": "Stash operation: save, pop, list, or clear",
      "required": false,
      "default": "save"
    }
  ],
  "estimatedExecutionTime": "2s",
  "confirmationRequired": false,
  "rollbackAvailable": false,
  "verificationSupported": true,
  "deprecationStatus": "stable"
