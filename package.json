{
  "name": "sentinel-terminal",
  "private": true,
  "version": "2.1.0",
  "description": "A terminal that takes requests in plain language and runs .flow files on macOS, Windows and Linux",
  "license": "MIT",
  "author": "Pranav Dubey (NetPranav)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NetPranav/Sentinal-Terminal.git"
  },
  "homepage": "https://github.com/NetPranav/Sentinal-Terminal#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle:linux": "tauri build",
    "bundle:deb": "tauri build --bundles deb",
    "bundle:rpm": "tauri build --bundles rpm",
    "bundle:appimage": "tauri build --bundles appimage",
    "bundle:mac": "tauri build --bundles app",
    "bundle:dmg": "tauri build --bundles dmg",
    "check:triple": "npm test && npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "agent": "tsx scripts/agent-cli.ts",
    "cli": "tsx scripts/agent-cli.ts",
    "benchmark": "tsx scripts/benchmark_prompts.ts",
    "benchmark:domain": "tsx scripts/benchmark_prompts.ts --domain",
    "smoke:engine": "tsx scripts/engine_smoke.ts",
    "stress": "bash scripts/stress/run.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.45.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
