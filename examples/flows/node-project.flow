{
  "schemaVersion": "1.0",
  "metadata": {
    "id": "node-project",
    "name": "Node.js project from zero",
    "description": "Installs Node.js and Git if missing, clones a project, installs its dependencies, runs its tests and opens it in VS Code. Works on macOS, Windows and Linux."
  },
  "actions": [
    { "type": "install", "package": "nodejs" },
    { "type": "install", "package": "git" },
    { "type": "clone", "repo": "https://github.com/expressjs/express.git", "into": "~/cero-demo/express" },
    { "type": "command", "name": "Install dependencies", "command": "npm install", "cwd": "~/cero-demo/express" },
    { "type": "command", "name": "Run the tests", "command": "npm test", "windows": "npm.cmd test", "cwd": "~/cero-demo/express" },
    { "type": "app", "name": "Open the project in VS Code", "app": "VS Code", "path": "~/cero-demo/express" },
    { "type": "browser", "name": "Open the Express guide", "url": "https://expressjs.com/en/starter/hello-world.html" }
  ]
}
