{
  "name": "cero-terminal-integration",
  "displayName": "Cero",
  "description": "First-Class macOS Desktop Terminal Emulator integration for Visual Studio Code",
  "version": "1.0.0",
  "publisher": "cero",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Terminal"
  ],
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "cero-terminal.profile",
          "title": "Cero",
          "path": "/Applications/Cero.app/Contents/MacOS/Cero",
          "icon": "terminal",
          "overrideName": true
        }
      ]
    },
    "commands": [
      {
        "command": "cero-terminal.openInCero",
        "title": "Open in Cero",
        "category": "Terminal"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cero-terminal.openInCero",
          "group": "2_workspace",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {},
  "keywords": [
    "terminal",
    "macos",
    "cero",
    "pty",
    "shell"
  ],
  "license": "MIT"
}
